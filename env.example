# opencode service: variable = template value
PORT=4096
OPENCODE_HOSTNAME=0.0.0.0
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
HOME=/data/home
OPENCODE_WORKSPACE=/data/workspace
OPENCODE_DISABLE_AUTOUPDATE=true
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
# Optional model provider keys (leave empty; the free OpenCode Zen models work without any key)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional, add later if wanted (not template variables):
# GIT_USER_NAME=        # commit author name, applied on first boot only
# GIT_USER_EMAIL=       # commit author email, applied on first boot only
# OPENCODE_ALLOW_NO_PASSWORD=false   # entrypoint refuses to start without a password unless true
